# Social Media Platform API Credentials
# Copy this file to .env and fill in your actual API credentials
# Note: Vite requires environment variables to start with VITE_

# Facebook/Meta API
VITE_FACEBOOK_CLIENT_ID=your_facebook_app_id_here
VITE_FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here

# Instagram Basic Display API
VITE_INSTAGRAM_CLIENT_ID=your_instagram_client_id_here
VITE_INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret_here

# Twitter API v2
VITE_TWITTER_CLIENT_ID=your_twitter_client_id_here
VITE_TWITTER_CLIENT_SECRET=your_twitter_client_secret_here

# LinkedIn API
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
VITE_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# YouTube Data API v3
VITE_YOUTUBE_CLIENT_ID=your_youtube_client_id_here
VITE_YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here

# TikTok API (optional)
VITE_TIKTOK_CLIENT_ID=your_tiktok_client_id_here
VITE_TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# Instructions:
# 1. Create developer accounts on each platform:
#    - Facebook: https://developers.facebook.com/
#    - Instagram: https://developers.facebook.com/docs/instagram-basic-display-api/
#    - Twitter: https://developer.twitter.com/
#    - LinkedIn: https://www.linkedin.com/developers/
#
# 2. Create apps and get your API credentials
#
# 3. Set up OAuth redirect URIs:
#    - Facebook: http://localhost:3001/auth/facebook/callback
#    - Instagram: http://localhost:3001/auth/instagram/callback
#    - Twitter: http://localhost:3001/auth/twitter/callback
#    - LinkedIn: http://localhost:3001/auth/linkedin/callback
#
# 4. Copy this file to .env and replace the placeholder values with your actual credentials
